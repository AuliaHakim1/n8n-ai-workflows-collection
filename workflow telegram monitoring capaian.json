    {
      "parameters": {
        "jsCode": "// Ambil input nama dari user\nconst inputNama = $items(\"Edit Fields\")[0].json.nama || \"\";\n\n// Cek apakah ada data dari Google Sheets\nif (!items || items.length === 0) {\n    return [{ json: { ditemukan: false } }];\n}\n\n// Cari data yang cocok\nconst result = items.find(item => {\n    // Pastikan field \"nama\" di sheet tidak kosong sebelum di-toLowerCase\n    const namaDiSheet = item.json.nama ? item.json.nama.toString().toLowerCase().trim() : \"\";\n    return namaDiSheet === inputNama.toLowerCase().trim();\n});\n\nif (result) {\n    return [result];\n} else {\n    return [{ json: { ditemukan: false } }];\n}"
      },
